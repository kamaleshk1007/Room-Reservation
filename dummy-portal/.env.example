# Dummy college portal - example environment file. Copy to .env before running.
# Values here are for LOCAL DEVELOPMENT of the dummy portal only.

PORTAL_PORT=8090
PORTAL_DB_URL=jdbc:mysql://127.0.0.1:3306/dummy_portal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PORTAL_DB_USERNAME=root
PORTAL_DB_PASSWORD=rootpass123

# Base64-encoded secret (32+ bytes) used to sign the PORTAL_SESSION cookie.
# Room Reserve verifies the same cookie with the same secret.
# For any real deployment, generate your own: openssl rand -base64 32
PORTAL_COOKIE_SECRET=E516NQJwdmUNWgDq4cueJ+IO32BvylFWX7JlrDe41Mg=

# Cookie Secure flag: false locally (plain HTTP), true in production
PORTAL_COOKIE_SECURE=false

# Portal session lifetime in seconds (default 8 hours)
PORTAL_SESSION_TTL_SECONDS=28800

# Seed credentials for portal users. These are the same staff IDs Room Reserve uses.
# Never commit real credentials; override in .env with your own.
PORTAL_SEED_HOD_PASSWORD=password123
PORTAL_SEED_STAFF_PASSWORD=password123
PORTAL_SEED_STAFF002_PASSWORD=password123
