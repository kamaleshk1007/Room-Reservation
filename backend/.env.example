# Copy this file to .env and adjust the values for your machine.
# .env is gitignored and must never be committed.

SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/room_reservation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=room_user
DB_PASSWORD=room_password

JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173
