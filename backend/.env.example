# Copy this file to .env and adjust the values for your machine.
# .env is gitignored and must never be committed.
# Generate secrets with: openssl rand -base64 32

PORT=8080

DB_URL=jdbc:mysql://localhost:3306/room_reservation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Required only for portal-cookie SSO; the app boots without it.
PORTAL_COOKIE_SECRET=

# Set to true in production (HTTPS). false for local plain HTTP.
COOKIE_SECURE=false
